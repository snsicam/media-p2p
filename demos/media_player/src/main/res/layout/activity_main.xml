<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 视频 SurfaceView -->
    <SurfaceView
        android:id="@+id/surface_video"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/panel_connect"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 连接配置面板（连接前显示） -->
    <LinearLayout
        android:id="@+id/panel_connect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#CC1A1A1A"
        app:layout_constraintBottom_toTopOf="@id/panel_info">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_relay"
            android:textColor="#AAAAAA"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/input_relay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_relay"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:inputType="textUri"
            android:singleLine="true"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_device_id"
            android:textColor="#AAAAAA"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/input_device_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_device_id"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:inputType="text"
            android:singleLine="true"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_connect"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/btn_connect"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- 状态信息栏 -->
    <LinearLayout
        android:id="@+id/panel_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#CC1A1A1A"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/txt_state"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/state_idle"
            android:textColor="#AAAAAA"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txt_stream_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#888888"
            android:textSize="11sp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btn_reconnect"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/btn_reconnect"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
